# ---- Servidor ----
PORT=4000
NODE_ENV=development
# Detrás de un proxy (Caddy, Nginx, Render...) pon 1 para que el límite de intentos use la IP real
# TRUST_PROXY=1

# ---- Base de datos MySQL 8 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=tenaristrack
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=tenaristrack

# ---- Seguridad ----
# Cadena aleatoria de 32+ caracteres:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
# Solo si la interfaz se sirve desde OTRO dominio (separados por coma). Vacío = mismo origen.
# CORS_ORIGIN=https://tu-dominio.com
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=300

# ---- Datos simulados (riesgo R01) ----
# true muestra el aviso «Datos simulados» en la interfaz
DEMO_MODE=true
DEMO_PASSWORD=Tenaris2026!

# ===== Variables para docker compose (copia este archivo como .env) =====
# Contraseñas largas y distintas. Genera una con:  openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 32+ caracteres aleatorios:  openssl rand -hex 48
JWT_SECRET=

# Dominio público (solo con el perfil https)
DOMINIO=tenaristrack.ejemplo.com

# true = muestra el aviso "Datos simulados" (úsalo solo con datos de demostración)
DEMO_MODE=false

# Solo si la interfaz se sirve desde otro dominio distinto al de la API
CORS_ORIGIN=

TRUST_PROXY=1
APP_PORT=4000
